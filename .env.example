# Copy this file to `.env` and fill in real values for your machine.
# NEVER commit the real .env file — it is excluded by .gitignore.

# A long random string used by Django for cryptographic signing.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to False for anything resembling production (shows safe error pages).
DJANGO_DEBUG=True

# Comma-separated hosts allowed to serve the app.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
